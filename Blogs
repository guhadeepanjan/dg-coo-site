        <span class="badge"><span class="dot"></span>Regulatory governance</span>
        <span class="badge"><span class="dot"></span>Transformation</span>
      </div>

      <div class="actionRow">
        <a class="btn primary" href="https://substack.com/@thedeeptrailblazer" target="_blank" rel="noreferrer">
