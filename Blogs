<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Insights | Deepanjan Guha</title>
  <meta name="description" content="Executive insights on banking operations, risk, governance, payments and transformation." />
  <link rel="stylesheet" href="css/style.css?v=1200" />

  <style>
    .pageHero{
      padding:28px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.12);
      background:
        radial-gradient(900px 420px at 20% 0%, rgba(47,125,255,.24), transparent 55%),
        radial-gradient(900px 420px at 85% 10%, rgba(0,209,193,.18), transparent 58%),
        rgba(255,255,255,.05);
      box-shadow: 0 22px 70px rgba(0,0,0,.35);
    }
    .pageHero h1{
      margin:10px 0 10px;
      font-size:34px;
      line-height:1.08;
      letter-spacing:-0.02em;
    }
    .pageHero p{
      margin:0;
      color:rgba(234,240,255,.74);
      font-size:14px;
      line-height:1.75;
      max-width:92ch;
    }

    .badgeRow{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:14px;
    }
    .badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.04);
      color:rgba(234,240,255,.78);
      font-size:12px;
      font-weight:800;
    }
    .badge .dot{
      width:8px; height:8px; border-radius:50%;
      background:linear-gradient(135deg, rgba(47,125,255,.95), rgba(0,209,193,.85));
      display:inline-block;
    }

    .actionRow{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top:16px;
    }

    .substackFrame{
      margin-top:18px;
      border-radius:18px;
      overflow:hidden;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.04);
      box-shadow: 0 18px 60px rgba(0,0,0,.30);
    }
    .substackFrame iframe{
      width:100%;
      height:1100px;
      border:0;
      display:block;
      background:transparent;
    }

    .fallback{
      margin-top:16px;
      padding:18px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.04);
    }
    .fallback .title{
      font-weight:900;
      font-size:14px;
      letter-spacing:.01em;
      margin-bottom:6px;
    }
    .fallback .small{
      color:rgba(234,240,255,.72);
      font-size:13px;
      line-height:1.7;
      margin:0;
    }

    @media (max-width:980px){
      .pageHero{padding:22px;}
      .pageHero h1{font-size:28px; line-height:1.12;}
      .substackFrame iframe{height:1250px;}
    }
  </style>
</head>

<body>
