    <section class="fallback">
      <div class="title">If the embedded feed doesn’t load</div>
      <p class="small">
        Some Substack setups restrict embeds. If you see a blank area above, use the button below — it always works.
      </p>
      <div class="actionRow" style="margin-top:12px;">
        <a class="btn primary" href="https://substack.com/@thedeeptrailblazer" target="_blank" rel="noreferrer">
          View all posts on Substack
        </a>
      </div>
    </section>

  </main>

  <footer class="footer">
